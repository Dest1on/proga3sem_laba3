<Window x:Class="PhotoEditor.Wpf.Views.FilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фильтр"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="15">

        <TextBlock Text="Выберите фильтр:" Margin="0,0,0,5"/>

        <ComboBox x:Name="FilterCombo"
                  SelectionChanged="FilterCombo_SelectionChanged">
            <ComboBoxItem Content="Яркость"/>
        </ComboBox>

        <!-- Панель яркости -->
        <StackPanel x:Name="BrightnessPanel"
                    Margin="0,10,0,0"
                    Visibility="Collapsed">

            <TextBlock Text="Яркость"/>

            <Slider x:Name="BrightnessSlider"
                    Minimum="-255"
                    Maximum="255"
                    Value="0"
                    TickFrequency="25"
                    IsSnapToTickEnabled="True"/>

            <TextBlock Text="{Binding ElementName=BrightnessSlider, Path=Value}"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="OK"
                    Width="80"
                    Margin="0,0,5,0"
                    Click="Ok_Click"/>

            <Button Content="Отмена"
                    Width="80"
                    Click="Cancel_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
