<Window x:Class="PhotoEditor.Wpf.Views.FilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PhotoEditor.Wpf.ViewModels"
        Title="Выбор фильтра"
        Width="250"
        Height="180"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="15">
        <TextBlock Text="Выберите фильтр:" Margin="0,0,0,10"/>

        <ComboBox x:Name="FilterBox" SelectedIndex="0">
            <ComboBoxItem Content="Нет"/>
            <ComboBoxItem Content="Яркость +50"/>
            <ComboBoxItem Content="Яркость -50"/>
        </ComboBox>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="OK" Width="80" Margin="5" Click="OkClick"/>
            <Button Content="Отмена" Width="80" Margin="5" Click="CancelClick"/>
        </StackPanel>
    </StackPanel>
</Window>
