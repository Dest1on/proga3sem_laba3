<Window x:Class="PhotoEditor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PhotoEditor.Wpf.ViewModels"
        Title="Photo Editor"
        Width="900"
        Height="600">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Left"
            Margin="0,0,0,10">

            <Button Content="Открыть"
                    Command="{Binding OpenImageCommand}"
                    Margin="0,0,5,0"/>

            <Button Content="Обрезать"
                    Command="{Binding CropCommand}"
                    Margin="0,0,5,0"/>

            <Button Content="Повернуть"
                    Command="{Binding RotateCommand}"
                    Margin="0,0,5,0"/>

            <Button Content="Фильтр"
                    Command="{Binding ApplyFilterCommand}"
                    Margin="0,0,5,0"/>

            <Button Content="Текст"
                    Command="{Binding AddTextCommand}"
                    Margin="0,0,5,0"/>

            <Button Content="Коллаж"
                    Command="{Binding CreateCollageCommand}"
                    Margin="0,0,5,0"/>

            <Button Content="Рисовать"
                    Command="{Binding EditPixelCommand}"/>
        </StackPanel>


        <Border Grid.Row="1"
                Margin="0,10,0,0"
                BorderThickness="1"
                BorderBrush="Gray">

            <Image Source="{Binding CurrentBitmap}"
                   Stretch="Uniform"/>
        </Border>
    </Grid>
</Window>
